{
	"model": {
	  "type": "minecraft:select",
	  "property": "custom_model_data",
	  "fallback": { "type": "model", "model": "lom:item/gui/npcs/carlthekobold_alt" },
	  "cases": [
		{ "when": "main", "model": { "type": "model", "model": "lom:item/gui/npcs/carlthekobold_main" } },
		{ "when": "alt", "model": { "type": "model", "model": "lom:item/gui/npcs/carlthekobold_alt" } },
		{ "when": "tailor", "model": { "type": "model", "model": "lom:item/gui/npcs/carlthekobold_tailor" } }
	  ]
	},
  "oversized_in_gui": true
}