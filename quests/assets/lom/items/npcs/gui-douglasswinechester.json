			{ "when": "alt", "model": { "type": "model", "model": "lom:item/gui/npcs/douglasswinechester_alt" } },
			{ "when": "reforge1", "model": { "type": "model", "model": "lom:item/gui/npcs/douglasswinechester_reforge1" } },
			{ "when": "reforge2", "model": { "type": "model", "model": "lom:item/gui/npcs/douglasswinechester_reforge2" } }
		]
	}
}