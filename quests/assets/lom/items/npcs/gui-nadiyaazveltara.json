		{ "when": "gambling_prep", "model": { "type": "model", "model": "lom:item/gui/npcs/nadiyaazveltara_gambling_prep" } },
		{ "when": "gambling_run", "model": { "type": "model", "model": "lom:item/gui/npcs/nadiyaazveltara_gambling_run" } },
      	{ "when": "gambling_frame", "model": { "type": "model", "model": "lom:item/gui/npcs/nadiyaazveltara_gambling_frame" } },
		{ "when": "gambling_again", "model": { "type": "model", "model": "lom:item/gui/npcs/nadiyaazveltara_gambling_again" } },
		{ "when": "fence", "model": { "type": "model", "model": "lom:item/gui/npcs/nadiyaazveltara_fence" } }
	  ]
