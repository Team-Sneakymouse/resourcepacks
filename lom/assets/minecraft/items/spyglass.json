{
  "model": {
    "type": "range_dispatch",
    "property": "custom_model_data",
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "fallback": { "type": "minecraft:model", "model": "minecraft:item/spyglass_in_hand" },
      "cases": [
        { "when": [ "gui", "ground", "fixed" ], "model": { "type": "minecraft:model", "model": "minecraft:item/spyglass" } }
      ]
    },
    "entries": [
      { "threshold": 1, "model": { "type": "minecraft:model", "model": "lom:item/items/tinderflame_in_hand" }},
      { "threshold": 2, "model": { "type": "minecraft:model", "model": "lom:item/tools/magnifyingglass" }}
    ]
  }
}