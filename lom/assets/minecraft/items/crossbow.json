{
  "model": {
    "type": "range_dispatch",
    "property": "custom_model_data",
    
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:crossbow/pull",
        "fallback": { "type": "minecraft:model", "model": "minecraft:item/crossbow_pulling_0" },
        "entries": [
          { "threshold": 0.58, "model": { "type": "minecraft:model", "model": "minecraft:item/crossbow_pulling_1" } },
          { "threshold": 1.0, "model": { "type": "minecraft:model", "model": "minecraft:item/crossbow_pulling_2" } }
        ]
      },
      "on_false": {
        "type": "minecraft:select",
        "property": "minecraft:charge_type",
        "fallback": { "type": "minecraft:model", "model": "minecraft:item/crossbow" },
        "cases": [
          { "when": "arrow", "model": { "type": "minecraft:model", "model": "minecraft:item/crossbow_arrow" } },
          { "when": "rocket", "model": { "type": "minecraft:model", "model": "minecraft:item/crossbow_firework" } }
        ]
      }
    },

    "entries": [
      {
        "threshold": 1,
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:using_item",
          "on_true": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:crossbow/pull",
            "fallback": { "type": "minecraft:model", "model": "lom:item/weapons/gpo_bazooka0" },
            "entries": [
              { "threshold": 0.1, "model": { "type": "minecraft:model", "model": "lom:item/weapons/gpo_bazooka1" } },
              { "threshold": 0.58, "model": { "type": "minecraft:model", "model": "lom:item/weapons/gpo_bazooka2" } },
              { "threshold": 1.0, "model": { "type": "minecraft:model", "model": "lom:item/weapons/gpo_bazooka3" } }
            ]
          },
          "on_false": {
            "type": "minecraft:select",
            "property": "minecraft:charge_type",
            "fallback": { "type": "minecraft:model", "model": "lom:item/weapons/gpo_bazooka" },
            "cases": [
              { "when": "arrow", "model": { "type": "minecraft:model", "model": "lom:item/weapons/gpo_bazooka_charged" } },
              { "when": "rocket", "model": { "type": "minecraft:model", "model": "lom:item/weapons/gpo_bazooka_charged" } }
            ]
          }
        }
      }
    ]
  },
  "oversized_in_gui": true
}